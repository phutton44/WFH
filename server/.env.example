# Copy to .env for local runs. On Railway, set variables in the service dashboard.
DATABASE_URL=postgresql://user:pass@host:5432/railway
JWT_SECRET=use-a-long-random-string-in-production
PORT=3000
# Comma-separated browser origins allowed to call this API (your GitHub Pages site, http://localhost:5173, etc.)
CORS_ORIGIN=http://localhost:3000
